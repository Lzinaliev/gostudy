{
  "name": "go-course",
  "version": "1.0.0",
  "private": true,
  "description": "Курс по Go — десктопное приложение для Windows 10/11",
  "author": "Go Course",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node scripts/validate-content.mjs",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dev:web": "vite",
    "build:web": "npm run typecheck && vite build",
    "preview:web": "vite preview",
    "bot": "node bot/index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "ru.gocourse.desktop",
    "productName": "Go Course",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Курс по Go",
      "artifactName": "go-course-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "go-course-${version}-portable-${arch}.${ext}"
    }
  }
}

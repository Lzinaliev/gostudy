# Скопируйте в .env и заполните. Секреты не коммитьте в git.
# Токен бота от @BotFather (обязательно для npm run bot)
TELEGRAM_BOT_TOKEN=

# Порт локального API бота для проверки привязки Telegram
GOCOURSE_BOT_API=8788

# Папка данных приложения (app-state.json). По умолчанию %APPDATA%\go-course
GOCOURSE_DATA_DIR=

# Deep-link «Открыть приложение» в сообщениях бота
GOCOURSE_APP_URL=gocourse://open

# HTTP-прокси для api.telegram.org, если прямое соединение блокируется (например, http://127.0.0.1:7890)
HTTPS_PROXY=

# URL Cloudflare Worker для облачной синхронизации Mini App (см. README-MINIAPP.md).
# Заполняется только для npm run dev:web / build:web. Пример:
# VITE_API_URL=https://go-course-sync.yourname.workers.dev
VITE_API_URL=
